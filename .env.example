# 复制为 .env 后填写：  cp .env.example .env && chmod 600 .env
# .env 绝不提交到仓库，也不要发送给他人。

# hub-a（10.70.1.208，AW08-017363）的管理员密码
HUB_PASSWORD_HUB_A=

# 控制台管理员（用户名见 config.yaml 的 console_admin_user）
CONSOLE_ADMIN_PASSWORD=

# 代理首次注册令牌，生成方法：  openssl rand -hex 32
AGENT_ENROLLMENT_TOKEN=

# 会话签名密钥，生成方法：  openssl rand -hex 32
SESSION_SECRET=

# 后续通过向导添加 Hub 时，向导会自动追加 HUB_PASSWORD_<名称> 变量
